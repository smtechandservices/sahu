# Copy to .env and adjust. Loaded by core/settings.py via python-dotenv.
SECRET_KEY=change-me
DEBUG=True
# Leave unset to use local SQLite (backend/db.sqlite3).
# DATABASE_URL=postgres://USER:PASSWORD@your-db.xxxxxx.ap-southeast-2.rds.amazonaws.com:5432/sahu?sslmode=require

# AWS S3 for gallery / magazine / matrimonial files. Leave AWS_STORAGE_BUCKET_NAME
# unset to store files on local disk (backend/media/).
# AWS_STORAGE_BUCKET_NAME=sahu-media
# AWS_S3_REGION_NAME=ap-southeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional: CloudFront domain for public files, signed-URL lifetime (seconds)
# AWS_S3_CUSTOM_DOMAIN=
# AWS_QUERYSTRING_EXPIRE=3600

# Production (server) settings
# DEBUG=False
# ALLOWED_HOSTS=api.bihartailiksahusabha.com
# CSRF_TRUSTED_ORIGINS=https://api.bihartailiksahusabha.com
# STATIC_ROOT=/var/www/sahu/static
