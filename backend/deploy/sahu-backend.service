[Unit]
Description=Sahu Sabha Django backend (gunicorn)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/gunicorn core.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
